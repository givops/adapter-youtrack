<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.0.9</version><relativePath/></parent>
  <groupId>io.givops</groupId><artifactId>adapter-youtrack</artifactId><version>0.2.0-SNAPSHOT</version>
  <name>GivOps YouTrack adapter</name>
  <description>Public YouTrack ticketing provider library</description>
  <url>https://github.com/givops/adapter-youtrack</url>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url><distribution>repo</distribution></license></licenses>
  <scm><connection>scm:git:https://github.com/givops/adapter-youtrack.git</connection><url>https://github.com/givops/adapter-youtrack</url></scm>
  <properties><java.version>25</java.version><givops.adapter.version>0.2.0-SNAPSHOT</givops.adapter.version></properties>
  <dependencies>
    <dependency><groupId>io.givops</groupId><artifactId>adapter-spring-boot</artifactId><version>${givops.adapter.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>io.givops</groupId><artifactId>adapter-testkit</artifactId><version>${givops.adapter.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><configuration><archive><manifestEntries><Automatic-Module-Name>io.givops.adapter.youtrack</Automatic-Module-Name></manifestEntries></archive></configuration></plugin><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin></plugins></build>
</project>
